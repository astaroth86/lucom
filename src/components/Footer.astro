---
import { EMAIL, SITE_NAME, TEAM_LABEL } from "../consts";
---

<footer class="border-t border-[var(--color-line)]/60 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 text-sm text-[var(--color-muted)] sm:flex-row">
    <p>
      <span class="font-semibold text-[var(--color-ink)]">{SITE_NAME}</span>
      <span class="px-1.5">·</span>por {TEAM_LABEL}
    </p>
    <p><a href={`mailto:${EMAIL}`} class="hover:text-[var(--color-ink)]">{EMAIL}</a></p>
    <p>© {new Date().getFullYear()} {SITE_NAME}</p>
  </div>
</footer>
