---
import { EMAIL, OWNER, SITE_NAME, LINKEDIN } from "../consts";
---

<footer class="border-t border-[var(--color-line)]/60 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 text-sm text-[var(--color-muted)] sm:flex-row">
    <p>
      <span class="font-semibold text-[var(--color-ink)]">{SITE_NAME}</span>
      <span class="px-1.5">·</span>por {OWNER}
    </p>
    <div class="flex items-center gap-4">
      <a href={`mailto:${EMAIL}`} class="hover:text-[var(--color-ink)]">{EMAIL}</a>
      {LINKEDIN && (
        <a href={LINKEDIN} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-[var(--color-ink)]" aria-label="LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
          LinkedIn
        </a>
      )}
    </div>
    <p>© {new Date().getFullYear()} {SITE_NAME}</p>
  </div>
</footer>
