---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { servicios } from "../../data/servicios";
import { EMAIL } from "../../consts";

export function getStaticPaths() {
  return servicios.map((s) => ({
    params: { slug: s.slug },
    props: { servicio: s },
  }));
}

const { servicio } = Astro.props;
const otros = servicios.filter((s) => s.slug !== servicio.slug).slice(0, 3);
---

<Layout
  title={`${servicio.titulo} — LUCOM`}
  description={servicio.metaDescription}
>
  <Header />

  <main class="pt-32 pb-20 md:pt-40">
    <article class="mx-auto max-w-3xl px-5">
      <!-- Migas -->
      <nav class="mb-8 text-sm text-[var(--color-muted)]" aria-label="Migas de pan">
        <a href="/" class="hover:text-[var(--color-ink)]">Inicio</a>
        <span class="px-2">/</span>
        <a href="/#servicios" class="hover:text-[var(--color-ink)]">Servicios</a>
        <span class="px-2">/</span>
        <span class="text-[var(--color-ink)]">{servicio.titulo}</span>
      </nav>

      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent)]">
        {servicio.grupo === "especialidad" ? "Especialidad" : "Servicio de apoyo"}
      </p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">
        {servicio.titulo}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-[var(--color-muted)]">
        {servicio.intro}
      </p>

      <h2 class="mt-12 text-2xl font-bold tracking-tight">Qué incluye</h2>
      <ul class="mt-6 space-y-3.5">
        {servicio.puntos.map((p) => (
          <li class="flex items-start gap-3 text-[var(--color-muted)]">
            <span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[var(--color-accent)]/15 text-[var(--color-accent)]" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            {p}
          </li>
        ))}
      </ul>

      <!-- CTA -->
      <div class="mt-12 rounded-2xl border border-[var(--color-accent)]/30 bg-gradient-to-br from-[var(--color-surface-2)] to-[var(--color-surface)] p-8">
        <h2 class="text-xl font-semibold">¿Tienes un proyecto en mente?</h2>
        <p class="mt-3 text-[var(--color-muted)]">
          Empezamos con un estudio técnico inicial para definir la mejor
          solución y darte un presupuesto claro.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/#contacto"
            class="rounded-xl bg-[var(--color-accent)] px-6 py-3 font-semibold text-[#04221d] transition-transform hover:-translate-y-0.5"
          >
            Solicitar estudio técnico
          </a>
          <a
            href={`mailto:${EMAIL}`}
            class="rounded-xl border border-[var(--color-line)] px-6 py-3 font-semibold transition-colors hover:border-[var(--color-accent)]/60"
          >
            {EMAIL}
          </a>
        </div>
      </div>

      <!-- Otros servicios -->
      <h2 class="mt-14 text-2xl font-bold tracking-tight">Otros servicios</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {otros.map((s) => (
          <a
            href={`/servicios/${s.slug}`}
            class="group rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)] p-5 transition-colors hover:border-[var(--color-accent)]/50"
          >
            <h3 class="font-semibold text-[var(--color-ink)]">{s.titulo}</h3>
            <span class="mt-2 inline-flex items-center gap-1 text-sm text-[var(--color-accent)]">
              Ver más
              <svg class="transition-transform group-hover:translate-x-0.5" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
    </article>
  </main>

  <Footer />
</Layout>
