---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { especialidades, serviciosApoyo } from "../../data/servicios";

const grupos = [
  { titulo: "Especialidad", acento: true, items: especialidades },
  { titulo: "Servicios de apoyo", acento: false, items: serviciosApoyo },
];
---

<Layout
  title="Servicios — LUCOM"
  description="Servicios de LUCOM: prototipos de hardware e IoT, diseño electrónico y PCB, programación embebida, y el software de apoyo (web, Android y administración de sistemas)."
>
  <Header />

  <main class="pt-32 pb-20 md:pt-40">
    <div class="mx-auto max-w-6xl px-5">
      <nav class="mb-8 text-sm text-[var(--color-muted)]" aria-label="Migas de pan">
        <a href="/" class="hover:text-[var(--color-ink)]">Inicio</a>
        <span class="px-2">/</span>
        <span class="text-[var(--color-ink)]">Servicios</span>
      </nav>

      <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">Servicios</h1>
      <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
        Mi especialidad es el hardware. El software lo acompaña para que tu
        solución sea completa de extremo a extremo.
      </p>

      {grupos.map((g) => (
        <section class="mt-12">
          <h2 class={`text-sm font-semibold uppercase tracking-wider ${g.acento ? "text-[var(--color-accent)]" : "text-[var(--color-muted)]"}`}>
            {g.titulo}
          </h2>
          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((s) => (
              <a
                href={`/servicios/${s.slug}`}
                class="group flex flex-col rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-7 transition-colors hover:border-[var(--color-accent)]/50"
              >
                <h3 class="text-lg font-semibold text-[var(--color-ink)]">{s.titulo}</h3>
                <p class="mt-3 flex-1 text-[var(--color-muted)]">{s.resumen}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-accent)]">
                  Ver más
                  <svg class="transition-transform group-hover:translate-x-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
