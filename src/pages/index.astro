---
import Layout from "../layouts/Layout.astro";

const EMAIL = "contacto@lucom.es";

// Configurable desde un .env (PUBLIC_FORMSPREE_ID=xxxxx). Sin él, el
// formulario cae con elegancia a un mailto:.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = formspreeId
  ? `https://formspree.io/f/${formspreeId}`
  : `mailto:${EMAIL}`;

const nav = [
  { href: "#que-hago", label: "Qué hago" },
  { href: "#servicios", label: "Servicios" },
  { href: "#proceso", label: "Cómo trabajo" },
  { href: "#sobre", label: "Sobre LUCOM" },
  { href: "#contacto", label: "Contacto" },
];

const problemas = [
  "Desarrollo de prototipos electrónicos",
  "Dispositivos que no funcionan correctamente",
  "Automatización de equipos",
  "Integración de sensores",
  "Mejora de productos existentes",
];

const servicios = [
  {
    titulo: "Diseño electrónico",
    items: ["Esquemas", "Selección de componentes", "Diseño de PCB"],
  },
  {
    titulo: "Programación embebida",
    items: ["Microcontroladores", "Comunicaciones", "Sensores"],
  },
  {
    titulo: "Prototipos",
    items: ["Montaje", "Pruebas", "Ajustes"],
  },
  {
    titulo: "Software web y Android",
    items: ["Aplicaciones web", "Apps Android", "Paneles e integraciones"],
  },
  {
    titulo: "Administración de sistemas",
    items: ["Servidores y redes", "Despliegues", "Mantenimiento"],
  },
  {
    titulo: "Estudio técnico",
    items: ["Análisis de viabilidad", "Definición de la solución", "Presupuesto cerrado"],
  },
];

const proceso = [
  {
    n: "01",
    titulo: "Estudio técnico inicial",
    texto: "Analizo tu necesidad y defino la mejor solución antes de empezar.",
  },
  {
    n: "02",
    titulo: "Diseño de la solución",
    texto: "Arquitectura, electrónica y software pensados para ser fiables.",
  },
  {
    n: "03",
    titulo: "Desarrollo del prototipo",
    texto: "Montaje y programación del sistema funcional.",
  },
  {
    n: "04",
    titulo: "Entrega y pruebas",
    texto: "Validación, ajustes finales y documentación del resultado.",
  },
];
---

<Layout>
  <!-- ── Navegación ──────────────────────────────────────── -->
  <header
    class="fixed inset-x-0 top-0 z-50 border-b border-[var(--color-line)]/60 bg-[var(--color-base)]/80 backdrop-blur-md"
  >
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="#top" class="flex items-center gap-2.5 font-extrabold tracking-tight">
        <span
          class="grid h-8 w-8 place-items-center rounded-lg border border-[var(--color-accent)]/40 text-[var(--color-accent)]"
          aria-hidden="true"
        >
          <svg width="18" height="18" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14 V44 H44"/></svg>
        </span>
        <span class="text-lg">LUCOM</span>
      </a>
      <nav class="hidden items-center gap-7 text-sm text-[var(--color-muted)] md:flex">
        {nav.map((i) => (
          <a href={i.href} class="transition-colors hover:text-[var(--color-ink)]">{i.label}</a>
        ))}
      </nav>
      <a
        href="#contacto"
        class="rounded-lg bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-[#04221d] transition-transform hover:-translate-y-0.5"
      >
        Solicitar estudio técnico
      </a>
    </div>
  </header>

  <main id="top">
    <!-- ── 1 · Cabecera ──────────────────────────────────── -->
    <section class="relative overflow-hidden pt-36 pb-24 md:pt-44 md:pb-32">
      <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
      <div class="glow absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-5 text-center">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] px-4 py-1.5 text-xs font-medium text-[var(--color-muted)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"></span>
          Ingeniería electrónica a medida
        </p>
        <h1 class="mx-auto max-w-4xl text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl">
          Diseño soluciones <br class="hidden sm:block" />
          electrónicas que
          <span class="bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-2)] bg-clip-text text-transparent">funcionan</span>.
        </h1>
        <p class="mx-auto mt-7 max-w-2xl text-lg text-[var(--color-muted)]">
          Diseño y desarrollo de soluciones electrónicas para empresas y
          profesionales. De la idea inicial al prototipo funcional.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="#contacto"
            class="rounded-xl bg-[var(--color-accent)] px-7 py-3.5 font-semibold text-[#04221d] transition-transform hover:-translate-y-0.5"
          >
            Solicitar estudio técnico
          </a>
          <a
            href="#servicios"
            class="rounded-xl border border-[var(--color-line)] px-7 py-3.5 font-semibold text-[var(--color-ink)] transition-colors hover:border-[var(--color-accent)]/60"
          >
            Ver servicios
          </a>
        </div>
      </div>
    </section>

    <!-- ── 2 · Qué hago ──────────────────────────────────── -->
    <section id="que-hago" class="border-t border-[var(--color-line)]/60 py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2 md:items-center">
        <div>
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
            Soluciones electrónicas a medida
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-[var(--color-muted)]">
            Desarrollo sistemas electrónicos personalizados desde la idea
            inicial hasta el prototipo funcional.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-[var(--color-muted)]">
            Trabajo con empresas y profesionales que necesitan soluciones
            fiables y bien diseñadas.
          </p>
        </div>
        <div class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-8">
          <h3 class="text-xl font-semibold">¿En qué puedo ayudarte?</h3>
          <ul class="mt-6 space-y-3.5">
            {problemas.map((p) => (
              <li class="flex items-start gap-3 text-[var(--color-muted)]">
                <span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[var(--color-accent)]/15 text-[var(--color-accent)]" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── 3 · Servicios ─────────────────────────────────── -->
    <section id="servicios" class="border-t border-[var(--color-line)]/60 py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-5">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Servicios</h2>
          <p class="mt-4 text-lg text-[var(--color-muted)]">
            Desde la electrónica hasta el software que la pone en marcha.
          </p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {servicios.map((s) => (
            <div class="group rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-7 transition-colors hover:border-[var(--color-accent)]/50">
              <h3 class="text-lg font-semibold text-[var(--color-ink)]">{s.titulo}</h3>
              <ul class="mt-4 space-y-2 text-[var(--color-muted)]">
                {s.items.map((it) => (
                  <li class="flex items-center gap-2.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]/70"></span>
                    {it}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="mt-10 rounded-2xl border border-[var(--color-accent)]/30 bg-gradient-to-br from-[var(--color-surface-2)] to-[var(--color-surface)] p-8 md:p-10">
          <h3 class="text-xl font-semibold text-[var(--color-accent)]">Estudio técnico inicial</h3>
          <p class="mt-3 max-w-3xl text-lg leading-relaxed text-[var(--color-muted)]">
            Antes de empezar cualquier proyecto realizo un estudio técnico
            inicial para definir la mejor solución, acotar el alcance y darte un
            presupuesto claro.
          </p>
        </div>
      </div>
    </section>

    <!-- ── 4 · Cómo trabajo ──────────────────────────────── -->
    <section id="proceso" class="border-t border-[var(--color-line)]/60 py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-5">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Cómo trabajo</h2>
          <p class="mt-4 text-lg text-[var(--color-muted)]">
            Trabajo con procesos claros para asegurar resultados fiables.
          </p>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {proceso.map((p) => (
            <li class="relative rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-7">
              <span class="text-3xl font-extrabold text-[var(--color-accent)]/30">{p.n}</span>
              <h3 class="mt-3 text-lg font-semibold">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── 5 · Sobre LUCOM ───────────────────────────────── -->
    <section id="sobre" class="border-t border-[var(--color-line)]/60 py-20 md:py-28">
      <div class="mx-auto max-w-3xl px-5 text-center">
        <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Sobre LUCOM</h2>
        <p class="mt-7 text-lg leading-relaxed text-[var(--color-muted)]">
          LUCOM es un servicio especializado en el desarrollo de sistemas
          electrónicos a medida. Trabajo directamente con cada cliente para
          diseñar soluciones técnicas eficaces y fiables.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-[var(--color-muted)]">
          Experiencia en electrónica, sistemas embebidos, programación,
          desarrollo web y de aplicaciones Android, y administración de sistemas.
        </p>
      </div>
    </section>

    <!-- ── 6 · Contacto ──────────────────────────────────── -->
    <section id="contacto" class="border-t border-[var(--color-line)]/60 py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
            Cuéntame tu proyecto
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-[var(--color-muted)]">
            Puedes escribirme y te responderé en menos de 24 horas.
          </p>
          <a
            href={`mailto:${EMAIL}`}
            class="mt-8 inline-flex items-center gap-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)] px-5 py-4 font-medium transition-colors hover:border-[var(--color-accent)]/60"
          >
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-[var(--color-accent)]/15 text-[var(--color-accent)]" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            </span>
            {EMAIL}
          </a>
        </div>

        <form
          action={formAction}
          method="POST"
          class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-7 md:p-8"
        >
          <div class="space-y-5">
            <div>
              <label for="nombre" class="mb-2 block text-sm font-medium">Nombre</label>
              <input
                id="nombre"
                name="nombre"
                type="text"
                required
                autocomplete="name"
                class="w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-base)] px-4 py-3 text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-accent)]"
              />
            </div>
            <div>
              <label for="email" class="mb-2 block text-sm font-medium">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-base)] px-4 py-3 text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-accent)]"
              />
            </div>
            <div>
              <label for="mensaje" class="mb-2 block text-sm font-medium">Mensaje</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="4"
                required
                class="w-full resize-y rounded-lg border border-[var(--color-line)] bg-[var(--color-base)] px-4 py-3 text-[var(--color-ink)] outline-none transition-colors focus:border-[var(--color-accent)]"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full rounded-lg bg-[var(--color-accent)] px-6 py-3.5 font-semibold text-[#04221d] transition-transform hover:-translate-y-0.5"
            >
              Enviar mensaje
            </button>
            {!formspreeId && (
              <p class="text-center text-xs text-[var(--color-muted)]">
                Configura <code>PUBLIC_FORMSPREE_ID</code> para recibir los
                envíos en tu correo automáticamente.
              </p>
            )}
          </div>
        </form>
      </div>
    </section>
  </main>

  <!-- ── Pie ─────────────────────────────────────────────── -->
  <footer class="border-t border-[var(--color-line)]/60 py-10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 text-sm text-[var(--color-muted)] sm:flex-row">
      <p class="font-semibold text-[var(--color-ink)]">LUCOM</p>
      <p>Ingeniería electrónica a medida · {EMAIL}</p>
      <p>© {new Date().getFullYear()} LUCOM</p>
    </div>
  </footer>
</Layout>
