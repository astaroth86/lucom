# ID del formulario de Formspree (https://formspree.io).
# Sin esta variable el formulario usa un enlace mailto: como alternativa.
PUBLIC_FORMSPREE_ID=

# Token de Cloudflare Web Analytics (dashboard → Analytics → Web Analytics →
# add a site → copia el "token" del snippet). Sin él no se carga el beacon.
PUBLIC_CF_BEACON_TOKEN=

# Código de verificación de Google Search Console (método "etiqueta HTML":
# copia solo el valor del atributo content). Sin él no se añade la etiqueta.
PUBLIC_GSC_VERIFICATION=
